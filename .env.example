# Generated values belong in .env (gitignored). Do not use these placeholders.
KUBEBT_PORT=18081
KUBEBT_BIND_ADDRESS=127.0.0.1
PLATFORM_PUBLIC_URL=http://127.0.0.1:18081
MYSQL_DATABASE=kube_bt_sync
MYSQL_USER=kube_bt_sync
MYSQL_ROOT_PASSWORD=replace-with-a-random-value
MYSQL_PASSWORD=replace-with-a-random-value
REDIS_PASSWORD=replace-with-a-random-value
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-strong-password
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
KUBEBT_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes

# Optional build overrides for networks that cannot reach Google Container Registry.
# BASE_RUNTIME=gcr.m.daocloud.io/distroless/static-debian12:nonroot
# GOPROXY=https://goproxy.cn,direct
